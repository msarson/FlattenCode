<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <AssemblyName>FlattenCode</AssemblyName>
    <RootNamespace>FlattenCode</RootNamespace>
    <TargetFramework>net40</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <UseWindowsForms>True</UseWindowsForms>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <LangVersion>12.0</LangVersion>
    <Version>1.0.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\FlattenCodeIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ICSharpCode.Core">
      <HintPath>$(ClarionBin)\ICSharpCode.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpDevelop">
      <HintPath>$(ClarionBin)\ICSharpCode.SharpDevelop.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICSharpCode.TextEditor">
      <HintPath>$(ClarionBin)\ICSharpCode.TextEditor.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>


  <!-- The .addin manifest is hand-maintained, and it drifts. FlattenCode shipped 1.0.1, 1.0.2 and
       1.0.3 all declaring version="1.0", which left Addin Finder offering an update that installing
       could never clear. A stale version is not visible at build time unless something looks, so
       this fails the Release build rather than letting another release go out wrong.

       Deliberately a check and not a rewriter: a build step that edits the manifest would hide the
       mistake instead of making someone fix it, and a bad regex would corrupt the file silently. -->
  <Target Name="CheckAddinVersion" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <AddinManifest>$(MSBuildProjectDirectory)\FlattenCode.addin</AddinManifest>
      <AddinManifestText>$([System.IO.File]::ReadAllText('$(AddinManifest)'))</AddinManifestText>
    </PropertyGroup>
    <Error Condition="!$(AddinManifestText.Contains('version=&quot;$(Version)&quot;'))"
           Text="FlattenCode.addin does not declare version=&quot;$(Version)&quot;. Update the &lt;Identity&gt; element to match, or Addin Finder will keep offering an update that installing cannot clear." />
    <Message Importance="high" Text="FlattenCode.addin declares version $(Version) - ok" />
  </Target>
</Project>
